GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=30000

# DOBOT is simulation-only unless --mode real is explicitly supplied.
DOBOTLINK_HOST=127.0.0.1
DOBOTLINK_PORT=9090
DOBOT_PORT_NAME=
DOBOT_CONNECT_TIMEOUT_SECONDS=10
DOBOT_COMMAND_TIMEOUT_MS=30000
DOBOT_MAX_RETRIES=2
DOBOT_PTP_MODE=1
DOBOT_VERIFY_TIMEOUT_SECONDS=5
DOBOT_VERIFY_START_DELAY_SECONDS=0.5
DOBOT_POSITION_TOLERANCE_MM=1
DOBOT_ROTATION_TOLERANCE_DEGREES=1
DOBOT_VERIFY_SAMPLES=3

# Real MOVE remains disabled until every test coordinate and safety bound is set.
DOBOT_TEST_X=
DOBOT_TEST_Y=
DOBOT_TEST_Z=
DOBOT_TEST_R=
DOBOT_MIN_X=
DOBOT_MAX_X=
DOBOT_MIN_Y=
DOBOT_MAX_Y=
DOBOT_MIN_Z=
DOBOT_MAX_Z=
DOBOT_MIN_R=
DOBOT_MAX_R=
