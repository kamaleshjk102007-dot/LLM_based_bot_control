GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.7-flash
GEMINI_TIMEOUT_MS=30000

DOBOTLINK_HOST=127.0.0.1
DOBOTLINK_PORT=9090
DOBOT_PORT_NAME=COM5

DOBOT_CONNECT_TIMEOUT_SECONDS=10
DOBOT_COMMAND_TIMEOUT_MS=30000
DOBOT_MAX_RETRIES=2
DOBOT_PTP_MODE=1

DOBOT_VERIFY_TIMEOUT_SECONDS=5
DOBOT_VERIFY_START_DELAY_SECONDS=0.5
DOBOT_POSITION_TOLERANCE_MM=1
DOBOT_ROTATION_TOLERANCE_DEGREES=1
DOBOT_VERIFY_SAMPLES=3

DOBOT_CALIBRATION_MAX_STEP_MM=5
DOBOT_ROTATION_MAX_STEP_DEGREES=5
DOBOT_CALIBRATION_SPEED_RATIO=5
DOBOT_CALIBRATION_ACCELERATION_RATIO=5

DOBOT_HOVER_HEIGHT_MM=40.0
 
# Supervised test position
DOBOT_TEST_X=220.0
DOBOT_TEST_Y=0.0
DOBOT_TEST_Z=20.0
DOBOT_TEST_R=0.0

# Dobot Magician Lite safety envelope for physical operation
DOBOT_MIN_X=100.0
DOBOT_MAX_X=320.0

DOBOT_MIN_Y=-320.0
DOBOT_MAX_Y=320.0

DOBOT_MIN_Z=-40.0
DOBOT_MAX_Z=140.0

DOBOT_MIN_R=-135.0
DOBOT_MAX_R=135.0